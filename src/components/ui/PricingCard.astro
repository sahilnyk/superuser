---
interface Props {
  title: string;
  price?: string;
  usd?: number;
  inr?: number;
  period?: string;
  description?: string;
  features: string[];
  recommended?: boolean;
  calLink?: string;
}

const { title, price, usd, inr, period, features, recommended = false, calLink } = Astro.props;
const flow = typeof usd === "number" && typeof inr === "number";
---

<!-- pricing card: shadcn Card + Badge + Separator + Button, animated price via number-flow -->
<article class:list={["card", { ring: recommended }]}>
  <div class="content">
    <div class="row">
      <span class="name">{title}</span>
      {recommended && <span class="badge">Most Popular</span>}
    </div>

    <div class="price">
      {
        flow ? (
          <number-flow class="nf-price" data-usd={usd} data-inr={inr}>{`$${usd}`}</number-flow>
        ) : (
          <span class="amount">{price}</span>
        )
      }
      {period && <span class="period">/{period}</span>}
    </div>

    <div class="separator"></div>

    <ul class="features">
      {
        features.map((f) => (
          <li>
            <svg class="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {f}
          </li>
        ))
      }
    </ul>

    {
      calLink && (
        <a class="button pricing-cta" href={calLink} target="_blank" rel="noopener noreferrer">
          Book a call
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    --card-bg: #0f1115;
    --fg: #fafafa;
    --primary: #fafafa;
    --primary-fg: #18181b;
    --muted-fg: #a1a1aa;
    --border: #27272a;

    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--fg);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card.ring {
    border-color: transparent;
    background: linear-gradient(to top, #050505, #16181d);
    box-shadow:
      0 0 0 2px var(--primary),
      0 22px 48px -18px rgba(0, 0, 0, 0.8);
  }

  @media (min-width: 561px) {
    .card.ring {
      transform: scale(1.04);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .name {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
  }

  .badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.7rem;
    line-height: 1rem;
    font-weight: 600;
    background: var(--primary);
    color: var(--primary-fg);
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
    min-height: 2.4rem;
  }

  .amount,
  .nf-price {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    --number-flow-char-height: 0.85em;
  }

  .period {
    align-self: flex-end;
    padding-bottom: 0.35rem;
    font-size: 0.8rem;
    line-height: 1;
    color: var(--muted-fg);
  }

  .separator {
    height: 1px;
    width: 100%;
    background: var(--border);
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .features li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.875rem;
    line-height: 1.35rem;
  }

  .check {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: #10b981;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 2.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--primary);
    color: var(--primary-fg);
    transition: opacity 0.15s ease;
  }

  .button:hover {
    opacity: 0.9;
  }

  .card.ring .button {
    background: linear-gradient(to top, #d4d4d8, #fafafa);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.6);
  }
</style>
