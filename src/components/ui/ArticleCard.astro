---
interface Props {
  title: string;
  description?: string;
  url: string;
  date?: Date;
  dateLabel?: string;
  tags?: string[];
}

const { title, description, url, date, dateLabel, tags } = Astro.props;
import { formatDate } from "../../utils/date";
---

<article>
  <a href={url} class="highlight-link card-title">{title}</a>
  {date && <time datetime={date.toISOString()}>{dateLabel ?? formatDate(date)}</time>}
  {description && <p class="muted-text">{description}</p>}
  {
    tags && (
      <div class="tags">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  article {
    padding: 1.25rem 0;
  }

  .card-title {
    display: inline-block;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--text-color);
    background-image: linear-gradient(#60a5fa, #60a5fa);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    background-position: left center;
    transition: background-size 0.3s ease, color 0.3s ease;
  }

  .card-title:hover {
    color: #0f172a;
    background-size: 100% 100%;
  }

  .muted-text {
    margin-top: 0.5rem;
  }

  time {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0;
    opacity: 0.35;
  }

  .tags {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .tags span {
    font-size: var(--text-xs);
    opacity: 0.5;
  }
</style>
