---
interface Props {
  title: string;
  description?: string;
  url: string;
  date?: Date;
  tags?: string[];
}

const { title, description, url, date, tags } = Astro.props;
import { formatDate } from "../../utils/date";
---

<article>
  <div class="title-row">
    <a href={url} class="highlight-link">{title}</a>
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
  </div>
  {description && <p class="muted-text">{description}</p>}
  {
    tags && (
      <div class="tags">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  article {
    padding: 1.25rem 0;
  }

  .title-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: baseline;
  }

  .title-row a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--text-color);
    justify-self: start;
    background-image: linear-gradient(#60a5fa, #60a5fa);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    background-position: left center;
    transition: background-size 0.3s ease, color 0.3s ease;
  }

  .title-row a:hover {
    color: #0f172a;
    background-size: 100% 100%;
  }

  .muted-text {
    margin-top: 0.5rem;
  }

  time {
    font-size: var(--text-xs);
    opacity: 0.5;
    white-space: nowrap;
    text-align: right;
  }

  .tags {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .tags span {
    font-size: var(--text-xs);
    opacity: 0.5;
  }
</style>
