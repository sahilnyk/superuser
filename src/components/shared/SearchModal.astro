---
---

<button type="button" class="search-trigger" id="search-trigger" aria-label="Search" aria-haspopup="dialog">
  <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
  </svg>
  <kbd class="search-kbd"><span class="mod">⌘</span>K</kbd>
</button>

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-modal">
    <div class="search-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="text" id="search-input" placeholder="Search posts, projects, notes..." autocomplete="off" />
      <button type="button" id="search-esc" class="esc-kbd" aria-label="Close search">Esc</button>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<script>
  type SearchItem = {
    title: string;
    description: string;
    url: string;
    section: string;
  };

  let searchIndex: SearchItem[] | null = null;
  let activeIndex = -1;
  let bound = false;

  const escapeHtml = (str: string) =>
    str.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));

  async function ensureIndex() {
    if (searchIndex) return searchIndex;
    const res = await fetch("/search-index.json");
    searchIndex = await res.json();
    return searchIndex;
  }

  function openModal() {
    const overlay = document.getElementById("search-overlay");
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    overlay?.classList.add("open");
    document.body.style.overflow = "hidden";
    input?.focus();
    ensureIndex();
  }

  function closeModal() {
    const overlay = document.getElementById("search-overlay");
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const results = document.getElementById("search-results");
    overlay?.classList.remove("open");
    document.body.style.overflow = "";
    if (input) input.value = "";
    if (results) results.innerHTML = "";
    activeIndex = -1;
  }

  function renderResults(items: SearchItem[]) {
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const results = document.getElementById("search-results");
    if (!results) return;
    if (!input?.value) {
      results.innerHTML = "";
      return;
    }
    if (items.length === 0) {
      results.innerHTML = `<p class="search-empty">No results.</p>`;
      return;
    }
    results.innerHTML = items
      .map(
        (item, i) => `
        <a href="${item.url}" class="search-result${i === activeIndex ? " active" : ""}" data-index="${i}">
          <span class="result-title">${escapeHtml(item.title)}</span>
          <span class="result-desc">${escapeHtml(item.description)}</span>
        </a>`
      )
      .join("");
  }

  function getMatches() {
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const query = input?.value.trim().toLowerCase() ?? "";
    if (!query || !searchIndex) return [];
    return searchIndex.filter(
      (item) =>
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query)
    );
  }

  function setup() {
    const overlay = document.getElementById("search-overlay");
    if (overlay) {
      overlay.classList.remove("open");
      document.body.style.overflow = "";
    }
    activeIndex = -1;

    if (bound) return;
    bound = true;

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("#search-trigger")) {
        openModal();
      } else if (target.closest("#search-esc")) {
        closeModal();
      } else if (target.id === "search-overlay") {
        closeModal();
      }
    });

    document.addEventListener("input", (e) => {
      const target = e.target as HTMLElement;
      if (target.id !== "search-input") return;
      activeIndex = -1;
      renderResults(getMatches());
    });

    document.addEventListener("keydown", (e) => {
      const overlayEl = document.getElementById("search-overlay");
      const isOpen = overlayEl?.classList.contains("open");

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen ? closeModal() : openModal();
        return;
      }

      if (!isOpen) return;

      if (e.key === "Escape") {
        closeModal();
        return;
      }

      const matches = getMatches();
      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, matches.length - 1);
        renderResults(matches);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        renderResults(matches);
      } else if (e.key === "Enter" && activeIndex >= 0 && matches[activeIndex]) {
        window.location.href = matches[activeIndex].url;
      }
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base);
  }

  .search-trigger svg {
    flex-shrink: 0;
  }


  .search-trigger:hover {
    color: var(--text-color);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.07);
  }

  .search-kbd {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    flex-shrink: 0;
    opacity: 0.8;
  }

  .mod {
    font-family: var(--font-sans);
    font-size: 1.35em;
    line-height: 1;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 1rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease;
    z-index: 1000;
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding: 4vh 0.75rem 0.75rem;
    }
  }

  .search-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal {
    position: relative;
    box-sizing: border-box;
    width: min(560px, 100%);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    background: rgba(17, 17, 17, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    transform: translateY(-8px) scale(0.98);
    transition: transform 0.2s ease;
  }

  .search-overlay.open .search-modal {
    transform: translateY(0) scale(1);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .search-input-row {
      gap: 0.5rem;
      padding: 0.85rem 0.85rem;
    }

    .esc-kbd {
      font-size: 0.65rem;
      padding: 0.2rem 0.35rem;
    }

    #search-input {
      font-size: 0.9rem;
    }
  }

  .search-input-row svg {
    flex-shrink: 0;
    color: #60a5fa;
    opacity: 0.9;
  }

  #search-input {
    flex: 1;
    min-width: 0;
    -webkit-appearance: none;
    appearance: none;
    background: none;
    border: none;
    outline: none;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
    color: var(--text-color);
    font-size: 1rem;
    font-family: var(--font-sans);
  }

  #search-input:focus {
    outline: none;
    box-shadow: none;
  }

  #search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .esc-kbd {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.25rem 0.45rem;
    flex-shrink: 0;
  }

  .search-results {
    overflow-y: auto;
    padding: 0.6rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(96, 165, 250, 0.3) transparent;
  }

  .search-results :global(.search-empty) {
    padding: 1.5rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.5;
  }

  .search-results :global(.search-result) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 0.75rem 0.7rem 1rem;
    margin: 0.15rem 0;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-color);
    background: rgba(96, 165, 250, 0);
    transition: background 0.25s ease;
  }

  .search-results :global(.search-result)::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: #60a5fa;
    transform: scaleY(0);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result.active) {
    background: rgba(96, 165, 250, 0.1);
  }

  .search-results :global(.search-result:hover)::before,
  .search-results :global(.search-result.active)::before {
    transform: scaleY(1);
  }

  .search-results :global(.result-title) {
    font-size: 0.875rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.result-desc) {
    font-size: 0.8rem;
    opacity: 0.55;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .search-kbd {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .search-trigger {
      flex-shrink: 0;
      padding: 0.3rem 0.4rem;
    }
  }
</style>
