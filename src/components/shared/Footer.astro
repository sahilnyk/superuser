---
const EMOJI = "https://cdn.jsdelivr.net/npm/emoji-datasource-apple@15.1.2/img/apple/64";
const emojis = [
  { code: "1f525", label: "fire" },
  { code: "2764-fe0f", label: "love" },
  { code: "1f3c4", label: "surfing" },
];
---

<footer class="footer">
  <div class="footer-cta">
    <p class="footer-cta__text">If you've read this far, you might be interested in what I do.</p>
    <a
      class="call-button group"
      href="https://cal.com/sahil-nayak-m4ulup/30min"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="call-button__inner">
        <span class="call-button__avatar">
          <img src="/sahilnyk.png" alt="Sahil" width="28" height="28" />
        </span>
        <span class="call-button__label">Book a Free Call</span>
      </span>
    </a>
  </div>
  <p class="made-with">
    made with
    <span class="emoji-swap" aria-hidden="true">
      {emojis.map((e, i) => (
        <img src={`${EMOJI}/${e.code}.png`} alt={e.label} style={`--i:${i}`} />
      ))}
    </span>
    in India
  </p>
</footer>

<style>
  .footer {
    position: relative;
    width: 100%;
    margin-top: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .footer-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 3.5rem 1rem 2.75rem;
    text-align: center;
  }

  .footer-cta__text {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .call-button {
    display: inline-flex;
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.5);
    border-radius: 1rem;
    background: #212121;
    color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 10px -4px rgba(15, 23, 42, 0.15);
    transition: transform 160ms ease, filter 160ms ease;
  }

  .call-button::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid #2a2a2a;
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-right: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .call-button:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  .call-button__inner {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.9rem;
  }

  .call-button__avatar {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 999px;
  }

  .call-button__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .made-with {
    margin: -0.5rem 0 1.5rem;
    font-size: var(--text-xs);
    opacity: 0.5;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .emoji-swap {
    position: relative;
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.2em;
  }

  .emoji-swap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: emoji-swap 6s infinite;
    animation-delay: calc(var(--i) * -2s);
  }

  @keyframes emoji-swap {
    0% { opacity: 0; transform: translateY(3px) scale(0.9); }
    6% { opacity: 1; transform: none; }
    27% { opacity: 1; transform: none; }
    33% { opacity: 0; transform: translateY(-3px) scale(0.9); }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .emoji-swap img {
      animation: none;
    }
    .emoji-swap img:first-child {
      opacity: 1;
    }
  }

</style>
