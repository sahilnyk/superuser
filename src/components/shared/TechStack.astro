---
const technologies = [
  { name: "Python", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" },
  { name: "TypeScript", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" },
  { name: "React", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" },
  { name: "PostgreSQL", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" },
  { name: "FastAPI", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg" },
  { name: "Django", icon: "https://api.iconify.design/simple-icons:django.svg?color=%2344B78B" },
  { name: "AWS", icon: "https://api.iconify.design/simple-icons:amazonwebservices.svg?color=%23FF9900" },
  { name: "Docker", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" },
  { name: "Terraform", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg" },
  { name: "Git", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" },
  { name: "Linux", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg" },
  { name: "Node.js", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-plain.svg" },
  { name: "LangChain", icon: "https://api.iconify.design/simple-icons:langchain.svg?color=%231C9C86" },
  { name: "Shadcn", icon: "https://api.iconify.design/simple-icons:shadcnui.svg?color=%23FFFFFF" },
  { name: "Claude", icon: "https://api.iconify.design/simple-icons:anthropic.svg?color=%23D97757" },
  { name: "Jenkins", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jenkins/jenkins-original.svg" },
];
---

<section class="tech-stack">
  <h2>Technologies I work on</h2>
  <div class="tech-carousel">
    <div class="tech-track">
      {technologies.concat(technologies).map((tech, index) => (
        <div class="tech-item" aria-hidden={index >= technologies.length ? "true" : undefined}>
          <img src={tech.icon} alt="" width="42" height="42" loading="lazy" decoding="async" />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-stack {
    margin: 3rem 0;
    padding: 2rem 0;
  }

  h2 {
    font-size: 20px !important;
    font-weight: 400;
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .tech-carousel {
    width: 100%;
    overflow: hidden;
  }

  .tech-track {
    --loop-offset: 1.5rem;
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .tech-track:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-track {
      animation: none;
    }
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 80px;
    opacity: 0.85;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .tech-item:hover {
    opacity: 1;
    transform: translateY(-3px);
  }

  .tech-item img {
    width: 42px;
    height: 42px;
    object-fit: contain;
  }

  .tech-item span {
    font-size: var(--text-xs);
    white-space: nowrap;
    opacity: 0.7;
  }

  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - var(--loop-offset)));
    }
  }

  @media (max-width: 768px) {
    .tech-stack {
      margin: 2rem 0;
      padding: 1.5rem 0;
    }

    .tech-stack h2 {
      font-size: 16px !important;
      margin-bottom: 1.5rem;
    }

    .tech-track {
      --loop-offset: 1rem;
      gap: 2rem;
      animation-duration: 40s;
    }

    .tech-item {
      min-width: 60px;
    }

    .tech-item img {
      width: 32px;
      height: 32px;
    }
  }
</style>
