---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import BaseHero from "../components/shared/BaseHero.astro";
import Container from "../components/ui/Container.astro";
import ContentList from "../components/shared/ContentList.astro";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const linkLabel = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host === "pypi.org") return "PyPI";
  if (host === "github.com") return "GitHub";
  return host;
};
---

<BaseLayout title="Projects" description="Check out my projects and work">
  <Container>
    <BaseHero title="Projects" description="Things I've built and worked on" />
    <ContentList>
      {
        sortedProjects.map((project) => (
          <article>
            <div class="proj-head">
              <h2 class="proj-title">{project.data.title}</h2>
              <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="proj-link">
                {linkLabel(project.data.url)} <span aria-hidden="true">&#8599;</span>
              </a>
            </div>

            <p class="muted-text">{project.data.description}</p>

            {project.data.install && (
              <div class="install">
                <code><span class="prompt">$</span> <span class="cmd">{project.data.install}</span></code>
                <button class="install-copy" data-cmd={project.data.install} aria-label="Copy install command">
                  <svg class="i i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="i i-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </button>
              </div>
            )}

            {project.data.techs && <p class="techs">{project.data.techs.join(" · ")}</p>}
          </article>
        ))
      }
    </ContentList>
  </Container>
</BaseLayout>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".install-copy").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.cmd);
          btn.classList.add("done");
          setTimeout(() => btn.classList.remove("done"), 1500);
        } catch {}
      });
    });
  });
</script>

<style>
  article {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  article:first-child {
    padding-top: 0.5rem;
  }

  article:last-child {
    border-bottom: none;
  }

  .proj-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .proj-title {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .proj-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #60a5fa;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.75;
    transition: opacity var(--transition-base);
  }

  .proj-link:hover {
    opacity: 1;
  }

  .muted-text {
    opacity: 0.7;
    line-height: 1.6;
    margin-bottom: 0.9rem;
  }

  .install {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    margin-bottom: 0.9rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
    overflow: hidden;
  }

  .install code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    padding: 0.6rem 0.85rem;
    white-space: nowrap;
    overflow-x: auto;
    color: var(--text-color);
  }

  .install .prompt {
    color: #60a5fa;
    user-select: none;
  }

  .install-copy {
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border-color);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition-base), background var(--transition-base);
  }

  .install-copy:hover {
    color: var(--text-color);
    background: rgba(255, 255, 255, 0.06);
  }

  .install-copy .i-check {
    display: none;
    color: #4ade80;
  }

  .install-copy.done .i-copy {
    display: none;
  }

  .install-copy.done .i-check {
    display: block;
  }

  .techs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    article {
      padding: 1.25rem 0;
    }
  }
</style>
