---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);

const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const readingTime = (content: string) => {
  const words = content.split(/\s+/).length;
  return Math.ceil(words / 200);
};
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <div id="progress-bar"></div>

  <a href="/notes" class="back-btn" aria-label="Back to notes">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/>
    </svg>
  </a>

  <div class="note-wrap">
  <article class="note">
    <header>
      <h1>{note.data.title}</h1>
      <div class="meta">
        <time datetime={note.data.publishedAt.toISOString()}>
          {formatDate(note.data.publishedAt)}
        </time>
        <span class="sep">·</span>
        <span>{readingTime(note.body)} min read</span>
        {note.data.category && <><span class="sep">·</span><span class="category">{note.data.category}</span></>}
      </div>
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        bar.style.width = progress + "%";
      };
      window.addEventListener("scroll", updateProgress);
      updateProgress();
    }
  });
</script>

<style>
  #progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #7b68ee, #60a5fa);
    z-index: 999;
    transition: width 0.1s linear;
  }

  .note-wrap {
    padding: 0 1.5rem;
  }

  .back-btn {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    opacity: 0.6;
    transition: opacity var(--transition-base), background var(--transition-base);
    z-index: 100;
    text-decoration: none;
  }

  .back-btn::after {
    display: none;
  }

  .back-btn:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }

  .note {
    margin-top: 0;
  }

  header {
    padding-top: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  h1 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    line-height: 1.35;
    font-weight: 400;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  .sep {
    opacity: 0.3;
  }

  .category {
    text-transform: capitalize;
  }

  .content {
    line-height: 1.8;
    font-size: var(--text-sm);
  }

  .content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .content :global(pre) {
    padding: 1.25rem;
    border-radius: 0.5rem;
    background: var(--hover-bg);
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--border-color);
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--border-color);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin: 0.5rem 0;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .note-wrap {
      padding: 0 1rem;
    }

    .back-btn {
      top: 3.5rem;
      left: 0.75rem;
      width: 36px;
      height: 36px;
    }

    h1 {
      font-size: 1.35rem;
    }
  }
</style>