---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Comments from "../../components/Comments.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const readingTime = (content: string) => {
  const words = content.split(/\s+/).length;
  return Math.ceil(words / 200);
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div id="progress-bar"></div>

  <a href="/blog" class="back-btn" aria-label="Back to blog">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/>
    </svg>
  </a>

  <div class="blog-wrap">
    <article class="post">
      <header>
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>
          <span class="sep">·</span>
          <span>{readingTime(post.body)} min read</span>
        </div>
        <p class="description">{post.data.description}</p>
      </header>
      <div class="content" id="post-content">
        <Content />
      </div>

      <Comments />
    </article>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        bar.style.width = progress + "%";
      };
      window.addEventListener("scroll", updateProgress);
      updateProgress();
    }

    document.querySelectorAll("#post-content pre").forEach((pre) => {
      if (pre.querySelector(".copy-btn-el")) return;

      pre.style.position = "relative";

      const btn = document.createElement("button");
      btn.className = "copy-btn-el";
      btn.textContent = "Copy";

      Object.assign(btn.style, {
        position: "absolute",
        top: "0.5rem",
        right: "0.5rem",
        padding: "0.25rem 0.6rem",
        fontSize: "0.65rem",
        border: "1px solid rgba(255,255,255,0.1)",
        borderRadius: "4px",
        background: "rgba(255,255,255,0.05)",
        color: "#888",
        opacity: "0.4",
        transition: "opacity 0.2s, color 0.2s, border-color 0.2s",
        cursor: "pointer",
        lineHeight: "1.4",
        fontFamily: "inherit",
      });

      pre.appendChild(btn);

      pre.addEventListener("mouseenter", () => { btn.style.opacity = "1"; });
      pre.addEventListener("mouseleave", () => {
        if (!btn.classList.contains("copied")) btn.style.opacity = "0.4";
      });

      const copyText = (text) => {
        if (navigator.clipboard) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise((resolve, reject) => {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand("copy");
            resolve();
          } catch {
            reject();
          }
          document.body.removeChild(ta);
        });
      };

      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const code = pre.querySelector("code");
        const text = code ? code.textContent : pre.textContent;
        if (!text) return;
        try {
          await copyText(text);
          btn.textContent = "Copied!";
          btn.style.opacity = "1";
          btn.style.borderColor = "#4ade80";
          btn.style.color = "#4ade80";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.style.borderColor = "rgba(255,255,255,0.1)";
            btn.style.color = "#888";
            btn.style.opacity = "0.4";
            btn.classList.remove("copied");
          }, 2000);
        } catch {
          btn.textContent = "Fail";
          setTimeout(() => { btn.textContent = "Copy"; }, 2000);
        }
      });
    });
  });
</script>

<style>
  #progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #7b68ee, #60a5fa);
    z-index: 999;
    transition: width 0.1s linear;
  }


  .back-btn {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    opacity: 0.6;
    transition: opacity var(--transition-base), background var(--transition-base);
    z-index: 100;
    text-decoration: none;
  }

  .back-btn::after {
    display: none;
  }

  .back-btn:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }

  .post {
    margin-top: 0;
  }

  header {
    margin-bottom: 3rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: 1.85rem;
    line-height: 1.3;
    font-weight: 500;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: #60a5fa;
    opacity: 0.9;
    margin-bottom: 1.25rem;
  }

  .sep {
    opacity: 0.4;
  }

  .description {
    font-size: var(--text-base);
    font-style: italic;
    opacity: 0.6;
    line-height: 1.6;
    padding-left: 0.85rem;
    border-left: 2px solid var(--border-color);
  }

  .content {
    line-height: 1.8;
    font-size: var(--text-sm);
  }

  .content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .content :global(img) {
    border-radius: 0.5rem;
    margin: 2rem 0;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--border-color);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .content :global(pre) {
    padding: 1rem;
    padding-top: 2rem;
    border-radius: 0.5rem;
    background: var(--hover-bg);
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--border-color);
  }

  .content :global(p) {
    max-width: 100%;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .content :global(a) {
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin: 0.5rem 0;
    line-height: 1.7;
  }

  .content :global(hr) {
    margin: 2.5rem 0;
    opacity: 0.2;
  }

  .related-posts {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .related-posts h2 {
    font-size: var(--text-xs);
    opacity: 0.4;
    margin-bottom: 1rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-link {
    font-size: var(--text-sm);
    color: var(--text-color);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--transition-base);
    display: inline-block;
  }

  .related-link::after {
    display: none;
  }

  .related-link:hover {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .blog-wrap {
      padding: 6rem 1rem 0;
    }

    header {
      padding-top: 1rem;
    }

    .back-btn {
      top: 3.5rem;
      left: 0.75rem;
      width: 36px;
      height: 36px;
    }

    h1 {
      font-size: 1.35rem;
    }

    .content {
      font-size: var(--text-sm);
    }

    .content :global(h2) {
      font-size: 1.15rem;
    }

    .content :global(h3) {
      font-size: 1.05rem;
    }

    .content :global(pre) {
      margin-left: -0.75rem;
      margin-right: -0.75rem;
      border-radius: 0;
    }
  }

  @media (max-width: 480px) {
    .blog-wrap {
      padding: 0 0.75rem;
    }
  }
</style>