---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
// Open Doodles ("Dog Jump") by Pablo Stanley. License: CC0 / public domain.
// https://www.opendoodles.com
import illo from "../assets/doodle-dog.svg?raw";
---

<BaseLayout title="404" description="The page you're looking for doesn't exist." noindex>
  <Container>
    <section class="nf">
      <h1>This page ran off</h1>
      <p class="line">The link is broken or the page has moved. There is nothing to fetch at this URL.</p>
      <p class="hire">Lost anyway? <a href="/hire-me">you can hire me</a>.</p>

      <div class="illo" role="img" aria-label="Hand-drawn illustration of a jumping dog" set:html={illo} />
    </section>
  </Container>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: 4rem 1rem 3rem;
    min-height: 74vh;
  }

  h1 {
    font-family: "Archivo Black", var(--font-sans, sans-serif);
    font-size: clamp(1.8rem, 6vw, 2.7rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .line {
    font-size: var(--text-sm);
    opacity: 0.6;
    line-height: 1.65;
    max-width: 430px;
  }

  .hire {
    margin-top: 1rem;
    font-size: var(--text-sm);
    opacity: 0.7;
  }

  .hire a {
    color: #60a5fa;
    text-decoration: none;
    background-image: linear-gradient(#60a5fa, #60a5fa);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: left bottom;
    transition: background-size 0.3s ease;
  }

  .hire a:hover {
    background-size: 100% 1px;
  }

  .illo {
    width: min(460px, 86vw);
    margin-top: 2.5rem;
  }

  .illo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
